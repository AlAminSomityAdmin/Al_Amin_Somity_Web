{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Musharaka Loan Schema",
  "type": "object",
  "required": ["totalCapital", "bankShare", "clientShare", "profitSharingRatio", "businessType", "durationMonths"],
  "properties": {
    "totalCapital": {
      "type": "number",
      "minimum": 5000
    },
    "bankShare": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "ব্যাংকের শেয়ার (%)"
    },
    "clientShare": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "ক্লায়েন্টের শেয়ার (%)"
    },
    "profitSharingRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "লাভ বণ্টনের অনুপাত (%)"
    },
    "lossSharingRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "ক্ষতি বণ্টনের অনুপাত (%)"
    },
    "businessType": {
      "type": "string",
      "enum": ["trading", "manufacturing", "service", "agriculture", "livestock", "other"]
    },
    "businessDescription": {
      "type": "string"
    },
    "durationMonths": {
      "type": "integer",
      "minimum": 6,
      "maximum": 120
    },
    "managementFee": {
      "type": "number",
      "description": "ব্যবস্থাপনা ফি (%)"
    },
    "exitClause": {
      "type": "string",
      "description": "একজিট ক্লজ বিবরণ"
    }
  }
}