{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Istisna Schema",
  "type": "object",
  "required": ["projectType", "totalCost", "completionDate", "specifications"],
  "properties": {
    "projectType": {
      "type": "string",
      "enum": ["construction", "manufacturing", "infrastructure", "other"]
    },
    "projectDescription": {
      "type": "string"
    },
    "totalCost": {
      "type": "number"
    },
    "advancePayment": {
      "type": "number"
    },
    "progressPayments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "milestone": {
            "type": "string"
          },
          "percentage": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "completionDate": {
      "type": "string",
      "format": "date"
    },
    "specifications": {
      "type": "string",
      "description": "প্রকল্পের স্পেসিফিকেশন"
    },
    "warrantyPeriod": {
      "type": "integer",
      "description": "ওয়ারেন্টি সময় (মাস)"
    },
    "penaltyClause": {
      "type": "string"
    }
  }
}